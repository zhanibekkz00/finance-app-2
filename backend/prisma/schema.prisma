// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// 1. Пользователи
// =========================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  role         String    @default("user")
  isBlocked    Boolean   @default(false) @map("is_blocked")
  resetOtp       String?   @map("reset_otp")
  resetOtpExpiry DateTime? @map("reset_otp_expiry") @db.Timestamptz(6)
  // Groups
  groupId      String?   @map("group_id") @db.Uuid
  group        Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Relations
  settings     UserSettings?
  categories   Category[]
  transactions Transaction[]
  debts        Debt[]
  budgets      Budget[]
  supportMessages SupportMessage[]
  savingsGoals SavingsGoal[]
  notificationReads NotificationRead[]

  @@map("users")
}

// =========================
// 1.5. Группы (Shared Spaces)
// =========================

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  joinCode  String   @unique @map("join_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users        User[]
  transactions Transaction[]

  @@map("groups")
}

// =========================
// 2. Настройки пользователя
// =========================

enum ThemeMode {
  light
  dark
  system
}

enum Locale {
  ru
  kk
  en
}

model UserSettings {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  themeMode   ThemeMode @default(system) @map("theme_mode")
  locale      Locale    @default(ru)
  currencyCode String   @default("USD") @map("currency_code")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// =========================
// 3. Категории
// =========================

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  name        String
  colorValue  BigInt    @map("color_value")
  iconCode    Int       @map("icon_code")
  isDefault   Boolean   @default(false) @map("is_default")
  imageUrl    String?   @map("image_url")
  type        String    @default("expense")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
  @@map("categories")
}

// =========================
// 4. Транзакции
// =========================

enum TransactionType {
  income
  expense
}

enum RecurrenceInterval {
  daily
  weekly
  monthly
  none
}

model Transaction {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  categoryId        String?           @map("category_id") @db.Uuid
  type              TransactionType
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("USD")
  date              DateTime          @db.Timestamptz(6)
  note              String            @default("")
  isRecurring       Boolean           @default(false) @map("is_recurring")
  recurrenceInterval RecurrenceInterval @default(none) @map("recurrence_interval")
  nextOccurrence    DateTime?         @map("next_occurrence") @db.Timestamptz(6)
  isPinned          Boolean           @default(false) @map("is_pinned")
  reminderDaysBefore Int              @default(0) @map("reminder_days_before")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Groups
  groupId           String?           @map("group_id") @db.Uuid
  group             Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date(sort: Desc)])
  @@index([userId, categoryId])
  @@index([userId, type])
  @@map("transactions")
}

// =========================
// 5. Долги и кредиты
// =========================

model Debt {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  type            String
  creditorName    String   @map("creditor_name")
  totalAmount     Decimal  @db.Decimal(12, 2) @map("total_amount")
  remainingAmount Decimal  @db.Decimal(12, 2) @map("remaining_amount")
  currency        String   @default("USD")
  bankProduct     String?  @map("bank_product")
  annualRate      Float?   @map("annual_rate")
  termMonths      Int?     @map("term_months")
  startDate       DateTime? @map("start_date") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("debts")
}

// =========================
// 6. Уведомления
// =========================

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String
  target    String   @default("all")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reads     NotificationRead[]

  @@map("notifications")
}

model NotificationRead {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@map("notification_reads")
}

// =========================
// 7. Бюджеты
// =========================

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  amount      Float
  month       Int
  year        Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId])
  @@map("budgets")
}

// =========================
// 8. Сообщения поддержки
// =========================

model SupportMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  isRead    Boolean  @default(false) @map("is_read")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

// =========================
// 9. Цели накопления (Savings Goals)
// =========================

model SavingsGoal {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String
  targetAmount    Decimal  @db.Decimal(12, 2) @map("target_amount")
  currentAmount   Decimal  @db.Decimal(12, 2) @map("current_amount") @default(0)
  currency        String   @default("USD")
  targetDate      DateTime? @map("target_date") @db.Timestamptz(6)
  colorValue      BigInt?  @map("color_value")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}
